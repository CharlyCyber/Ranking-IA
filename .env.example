# --- Obligatorias para el bot ---
# Token del bot de Telegram (obtener en @BotFather)
TELEGRAM_TOKEN=

# Clave gratuita de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Chat privado destino para avisos de administración y compatibilidad heredada de permisos
CHAT_ID=

# ID numérico del usuario autorizado para /forceupdate y /testalerta (recomendado)
ADMIN_USER_ID=

# --- Frecuencia y Keep-Alive 24/7 ---
# Intervalo objetivo de revisión en minutos (por defecto 1; no garantiza que cada fuente publique cambios cada minuto)
UPDATE_INTERVAL_MINUTES=1

# all (default), bot (worker sin servidor web), web (API/dashboard solamente)
APP_MODE=all

# URL pública HTTPS del bot/dashboard (ej. https://usuario-ranking-ia.hf.space o https://tu-app.onrender.com)
# En Hugging Face Spaces se detecta sola vía SPACE_HOST; en Render activa el ping externo y la Mini App
PUBLIC_URL=

# --- Proveedores de IA (opcional; límites y disponibilidad dependen de cada proveedor) ---
# Clave gratuita de Groq Cloud (https://console.groq.com/keys) — respaldo ultrarrápido
GROQ_API_KEY=
# Opcional: listas CSV de modelos para actualizar sin cambiar código.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# Transcripción de notas de voz / audios (por defecto whisper-large-v3-turbo; alternativa: whisper-large-v3)
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Clave gratuita de OpenRouter (https://openrouter.ai/keys) — usa modelos :free como respaldo
OPENROUTER_API_KEY=

# Búsqueda web bajo demanda (Tavily API). Opcional; revisa cuota/precios actuales del proveedor.
TAVILY_API_KEY=
LIVE_SEARCH_DAILY_LIMIT=100
# El alias openrouter/free enruta dinámicamente; puedes definir tus fallbacks CSV.
OPENROUTER_FREE_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free

# --- Escala pública gratuita y Persistencia 24/7 (Opcionales) ---
# Canal público de Telegram (ej. @RankingIA_ES) para emitir alertas a miles de usuarios en 1 llamada
PUBLIC_CHANNEL_ID=

# Turso/libSQL remoto opcional para persistencia compartida entre réplicas (planes y límites cambian)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Tendencias y límites (Opcionales) ---
# Token de GitHub (sube el rate limit de la API de búsqueda de tendencias de 10 a 30 req/min)
GITHUB_TOKEN=

# URL raw de data/rankings.json en la rama `data` (respaldo remoto de datos)
DATA_JSON_URL=

# Hora UTC del briefing diario /hoy (0-23, por defecto 9)
DAILY_BRIEF_HOUR=9

# Presupuesto diario global de llamadas a LLM (por defecto 200)
LLM_DAILY_LIMIT=200

# Consultas de chat libre permitidas por usuario y hora (por defecto 10; los menús y /hoy son gratis)
USER_RATE_LIMIT=10
API_RATE_LIMIT_PER_MINUTE=120

# Desactivar Playwright en contenedores con poca RAM (true/false; por defecto false)
DISABLE_PLAYWRIGHT=false
