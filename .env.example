# --- Obligatorias ---
# Token del bot de Telegram (obtener en @BotFather)
TELEGRAM_TOKEN=

# Clave de Google AI Studio (para Gemini)
GEMINI_API_KEY=

# Chat ID de Telegram del administrador (recibe alertas de error)
CHAT_ID=

# --- Opcionales ---
# Token de GitHub (sube el rate limit de la API de búsqueda de tendencias)
GITHUB_TOKEN=

# URL raw de data/rankings.json en la rama `data` (respaldo remoto de datos)
DATA_JSON_URL=

# Hora local del briefing diario /hoy (0-23, por defecto 9)
DAILY_BRIEF_HOUR=9

# Presupuesto diario global de llamadas a Gemini (por defecto 200)
GEMINI_DAILY_LIMIT=200

# Consultas de texto permitidas por usuario y hora (por defecto 10)
USER_RATE_LIMIT=10
