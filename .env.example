# --- Obligatorias para el bot ---
# Token del bot de Telegram (obtener en @BotFather)
TELEGRAM_TOKEN=

# Clave gratuita de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Chat ID de Telegram del administrador (recibe errores y puede ejecutar /forceupdate)
CHAT_ID=

# --- Frecuencia y Keep-Alive 24/7 ---
# Cada cuántos minutos revisar los rankings y avisar si hay cambios (por defecto 60 = cada 1 hora)
UPDATE_INTERVAL_MINUTES=60

# URL pública HTTPS del bot/dashboard (ej. https://usuario-ranking-ia.hf.space o https://tu-app.onrender.com)
# En Hugging Face Spaces se detecta sola vía SPACE_HOST; en Render activa el ping externo y la Mini App
PUBLIC_URL=

# --- Fallbacks gratuitos de IA (Opcionales, 100% Free Tier) ---
# Clave gratuita de Groq Cloud (https://console.groq.com/keys) — respaldo ultrarrápido
GROQ_API_KEY=

# Clave gratuita de OpenRouter (https://openrouter.ai/keys) — usa modelos :free como respaldo
OPENROUTER_API_KEY=

# --- Escala pública gratuita y Persistencia 24/7 (Opcionales) ---
# Canal público de Telegram (ej. @RankingIA_ES) para emitir alertas a miles de usuarios en 1 llamada
PUBLIC_CHANNEL_ID=

# Base de datos SQLite en la nube gratis con Turso (https://turso.tech - 5 GB gratis, sin perder datos en reinicios)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Tendencias y límites (Opcionales) ---
# Token de GitHub (sube el rate limit de la API de búsqueda de tendencias de 10 a 30 req/min)
GITHUB_TOKEN=

# URL raw de data/rankings.json en la rama `data` (respaldo remoto de datos)
DATA_JSON_URL=

# Hora UTC del briefing diario /hoy (0-23, por defecto 9)
DAILY_BRIEF_HOUR=9

# Presupuesto diario global de llamadas a LLM (por defecto 200)
GEMINI_DAILY_LIMIT=200

# Consultas de chat libre permitidas por usuario y hora (por defecto 10; los menús y /hoy son gratis)
USER_RATE_LIMIT=10
